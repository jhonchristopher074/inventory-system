# For Apache hosting (e.g. InfinityFree). Copied into dist/ by every build.
#
# The app uses addresses like /inventory or /cashier/pos that exist only
# inside the app, not as files on the server. Without this, refreshing such
# a page (or opening a link to it) gives "404 Not Found". Every address that
# isn't a real file is sent to index.html, and the app shows the right page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# The page itself (index.html, also served for /inventory, /login ...) must
# be checked for a new version every time it's opened. InfinityFree tells
# browsers to keep it for 30 days, so after an update people kept getting
# the old version when they opened the site. The files in assets/ have the
# version in their names (index-Box0qK9M.js), so they can stay cached.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>
